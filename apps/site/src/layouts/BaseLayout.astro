---
import { siteIdentity } from "../lib/content"
import ModalHub from "../components/islands/ModalHub"
import ScrollRevealController from "../components/ScrollRevealController.astro"
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  robots?: "index_follow" | "noindex_follow" | "noindex_nofollow" | undefined
  social?: {
    title?: string | undefined
    description?: string | undefined
    imageUrl?: string | undefined
    imageAlt?: string | undefined
  } | undefined
  structuredData?: Array<Record<string, unknown>>
  contentAvailable?: boolean
}

const {
  title = siteIdentity.title,
  description = siteIdentity.description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  noindex = false,
  robots,
  social,
  structuredData = [],
  contentAvailable = true,
} = Astro.props

const robotsContent = robots === "noindex_follow" ? "noindex, follow" : robots === "noindex_nofollow" || noindex ? "noindex, nofollow" : null

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteIdentity.name,
  url: new URL("/", Astro.site).toString(),
}

const jsonLd = [
  ...(contentAvailable && Astro.url.pathname === "/" ? [websiteSchema] : []),
  ...structuredData,
]

const serializeJsonLd = (value: Record<string, unknown>) => JSON.stringify(value)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026")
---

<!doctype html>
<html lang={siteIdentity.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteIdentity.locale} />
    <meta property="og:site_name" content={siteIdentity.name} />
    <meta property="og:title" content={social?.title ?? title} />
    <meta property="og:description" content={social?.description ?? description} />
    <meta property="og:url" content={canonical} />
    {social?.imageUrl && <meta property="og:image" content={social.imageUrl} />}
    {social?.imageAlt && <meta property="og:image:alt" content={social.imageAlt} />}
    <meta name="twitter:card" content={social?.imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={social?.title ?? title} />
    <meta name="twitter:description" content={social?.description ?? description} />
    {social?.imageUrl && <meta name="twitter:image" content={social.imageUrl} />}
    {social?.imageAlt && <meta name="twitter:image:alt" content={social.imageAlt} />}
    {jsonLd.map((schema) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(schema)} />)}
  </head>
  <body>
    <div class="site-theme min-h-screen bg-[var(--site-color-bg)] text-[var(--site-color-text)] font-[family-name:var(--site-font-sans)] antialiased flex flex-col selection:bg-[color-mix(in_srgb,var(--site-color-brand-500)_20%,transparent)] selection:text-[var(--site-color-brand-500)]">
      <slot />
    </div>
    {contentAvailable && <ScrollRevealController />}
    {contentAvailable && <ModalHub client:load />}
  </body>
</html>
