---
import BaseLayout from "../layouts/BaseLayout.astro"
import SitePageFrame from "@crm/site-ui/astro/SitePageFrame"
import SitePageShell from "@crm/site-ui/astro/SitePageShell"
import NavigationIsland from "../components/islands/NavigationIsland"
import HeroIsland from "../components/islands/HeroIsland"
import EventsIsland from "../components/islands/EventsIsland"
import HousesIsland from "../components/islands/HousesIsland"
import SaunaChanIsland from "../components/islands/SaunaChanIsland"
import ProgramsIsland from "../components/islands/ProgramsIsland"
import VenuesIsland from "../components/islands/VenuesIsland"
import ReviewsIsland from "../components/islands/ReviewsIsland"
import TerritoryMapIsland from "../components/islands/TerritoryMapIsland"
import FaqLocationIsland from "../components/islands/FaqLocationIsland"
import BookingQuizIsland from "../components/islands/BookingQuizIsland"
import FloatingHelperIsland from "../components/islands/FloatingHelperIsland"
import ListingIsland from "../components/islands/ListingIsland"
import BlogSection from "../components/sections/BlogSection.astro"
import WhyUsSection from "../components/sections/WhyUsSection.astro"
import PartnersMarquee from "../components/sections/PartnersMarquee.astro"
import Footer from "../components/sections/Footer.astro"
import { siteIdentity } from "../lib/content"
import { PublicProfileIntro } from "@crm/site-ui"
import ContentFailure from "../components/ContentFailure.astro"
import { getPublishedRoute, toFooterNavigation, toSiteHero, toSiteNavigation, toSiteStructuredData } from "../lib/content/cms-public"
import { getHomepageSections } from "../lib/content/homepage-sections"

const path = `/${Astro.params.path ?? ""}`.replace(/\/$/, "") || "/"
const result = await getPublishedRoute(path, Astro.url.searchParams)
const page = result.status === "published" ? result.value.page : null
const homepageSections = getHomepageSections(page, false)
const publishedSiteSettings = result.status === "published" ? result.value.settings : null
const listing = result.status === "published" ? result.value.listing : null
const failure = result.status !== "published" ? result.status : null
if (failure) {
  Astro.response.status = failure === "not_found" ? 404 : 503
  Astro.response.statusText = failure === "not_found" ? "Not Found" : "Service Unavailable"
  Astro.response.headers.set("Cache-Control", "no-store")
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow")
  if (failure === "unavailable") Astro.response.headers.set("Retry-After", "60")
}
const navigation = publishedSiteSettings ? toSiteNavigation(publishedSiteSettings) : undefined
const footerNavigation = publishedSiteSettings ? toFooterNavigation(publishedSiteSettings) : undefined
const effectiveHero = page?.hero
const hero = effectiveHero ? toSiteHero(effectiveHero) : undefined
const profileKind = page?.kind === "resource_detail" ? "Ресурс" : page?.kind === "program_detail" ? "Программа" : null
const robots = !page
  ? "noindex_nofollow"
  : listing?.robots ?? (page.seo.indexPolicy === "noindex_follow" ? "noindex_follow" : page.seo.indexPolicy === "noindex_nofollow" ? "noindex_nofollow" : "index_follow")
const canonical = page?.seo.canonical.mode === "custom"
  ? page.seo.canonical.url
  : new URL(path, Astro.site).toString()
const failureTitle = failure === "not_found" ? "Страница не найдена" : "Сайт временно недоступен"
---

<BaseLayout
  title={page?.seo.title ?? `${failureTitle} — ${siteIdentity.name}`}
  description={page?.seo.description ?? "Попробуйте открыть страницу позже."}
  contentAvailable={Boolean(page)}
  canonical={canonical}
  robots={robots}
  social={page?.seo.social}
  structuredData={page ? toSiteStructuredData(page.seo.structuredData) : []}
>
  {page && <NavigationIsland {...(navigation ? { navigation } : {})} client:load />}
  <SitePageShell>
    {page ? <SitePageFrame>
      {hero && <HeroIsland {hero} client:load />}
      {profileKind && !hero && <PublicProfileIntro kindLabel={profileKind} title={page.title} summary={page.summary} bookingItem={`${profileKind}: ${page.title}`} />}
      {!profileKind && !hero && !listing && <h1 class="site-type-h1">{page.title}</h1>}
      {listing && <ListingIsland listing={listing} title={hero ? undefined : page.title} description={page.summary} client:load />}
      {homepageSections.map((section) => {
        if (section.key === "events") return <EventsIsland config={section.config} client:visible />
        if (section.key === "houses") return <HousesIsland config={section.config} client:visible />
        if (section.key === "sauna-chan") return <SaunaChanIsland config={section.config} client:visible />
        if (section.key === "programs") return <ProgramsIsland config={section.config} client:visible />
        if (section.key === "venues") return <VenuesIsland config={section.config} client:visible />
        if (section.key === "blog") return <BlogSection config={section.config} />
        if (section.key === "why-us") return <WhyUsSection config={section.config} />
        if (section.key === "reviews") return <ReviewsIsland config={section.config} client:visible />
        if (section.key === "map") return <TerritoryMapIsland config={section.config} client:visible />
        if (section.key === "faq" || section.key === "directions") return <FaqLocationIsland config={section.config} client:visible />
        if (section.key === "calculator") return <BookingQuizIsland config={section.config} client:visible />
        if (section.key === "partners") return <PartnersMarquee config={section.config} />
        return null
      })}
    </SitePageFrame> : <ContentFailure status={failure!} />}
    {page && page.sections.some((section) => section.key === "footer") && <Footer {...(footerNavigation ? { navigation: footerNavigation } : {})} />}
  </SitePageShell>
  {page && <FloatingHelperIsland client:idle />}
</BaseLayout>
