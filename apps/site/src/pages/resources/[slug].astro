---
import { ArrowLeft, ArrowRight, Check, Flame } from "lucide-react";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SitePageFrame from "@crm/site-ui/astro/SitePageFrame";
import SitePageShell from "@crm/site-ui/astro/SitePageShell";
import Footer from "../../components/sections/Footer.astro";
import NavigationIsland from "../../components/islands/NavigationIsland";
import { SAUNA_CHAN_DATA } from "../../data/resortData";
import { getPublishedSiteSettings, toFooterNavigation, toSiteNavigation } from "../../lib/content/cms-public";

const slug = Astro.params.slug;
const resource = slug && slug in SAUNA_CHAN_DATA
  ? SAUNA_CHAN_DATA[slug as keyof typeof SAUNA_CHAN_DATA]
  : null;
if (!resource) return Astro.redirect("/", 302);
const priceNumber = resource.priceFrom.match(/\d[\d\s]*/)?.[0]?.trim() ?? resource.priceFrom;
const canonical = new URL(`/resources/${Astro.params.slug}`, Astro.site).toString();
const publishedSiteSettings = await getPublishedSiteSettings();
const navigation = publishedSiteSettings ? toSiteNavigation(publishedSiteSettings) : undefined;
const footerNavigation = publishedSiteSettings ? toFooterNavigation(publishedSiteSettings) : undefined;
---

<BaseLayout title={`${resource.title} — Свистоплясово`} description={resource.description} canonical={canonical}>
  <NavigationIsland {...(navigation ? { navigation } : {})} client:load />
  <SitePageShell>
    <SitePageFrame variant="detail">
      <a href="/#sauna" class="inline-flex items-center gap-2 text-[13px] text-[#6b7280] hover:text-[#18191b] mb-6"><ArrowLeft className="w-4 h-4" />Назад к СПА</a>
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-7 grid grid-cols-2 gap-3">
          {resource.photos.map((photo: string, index: number) => <img src={photo} alt={`${resource.title}, фото ${index + 1}`} class={`w-full object-cover rounded-3xl ${index === 0 ? "col-span-2 aspect-[16/9]" : "aspect-square"}`} />)}
        </div>
        <div class="lg:col-span-5 lg:sticky lg:top-6 rounded-3xl bg-white p-6 sm:p-8">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#2B9E47]/10 text-[10px] font-semibold uppercase tracking-wider text-[#2B9E47]"><Flame className="w-3 h-3" />СПА-ресурс</div>
          <h1 class="mt-4 text-[30px] sm:text-[38px] font-semibold text-[#18191b] leading-tight">{resource.title}</h1>
          <p class="mt-3 text-[14px] text-[#6b7280] leading-relaxed">{resource.description}</p>
          <div class="mt-6 pt-5 border-t border-neutral-100"><div class="text-[11px] text-[#6b7280]">стоимость от</div><div class="text-[30px] font-semibold text-[#2B9E47]">{priceNumber} ₽</div></div>
          <div class="mt-6 space-y-2">{resource.tabs.map((tab: { id: string; label: string; content: string }) => <div class="p-3 rounded-2xl bg-[#f7f7f7] flex gap-3"><div class="w-7 h-7 rounded-xl bg-[#2B9E47]/10 text-[#2B9E47] flex items-center justify-center shrink-0"><Check className="w-4 h-4" /></div><div><div class="text-[13px] font-semibold text-[#18191b]">{tab.label}</div><div class="text-[12px] text-[#6b7280] mt-0.5">{tab.content}</div></div></div>)}</div>
          <button data-site-action="booking" data-site-item={`Ресурс: ${resource.title}`} class="mt-6 w-full h-[48px] rounded-full bg-[#2B9E47] hover:bg-[#23823a] text-white text-[14px] font-medium inline-flex items-center justify-center gap-2">Забронировать <ArrowRight className="w-4 h-4" /></button>
        </div>
      </section>
    </SitePageFrame>
    <Footer {...(footerNavigation ? { navigation: footerNavigation } : {})} />
  </SitePageShell>
</BaseLayout>
