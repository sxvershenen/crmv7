---
import BaseLayout from "../../layouts/BaseLayout.astro"
import SitePageShell from "@crm/site-ui/astro/SitePageShell"
import { siteIdentity } from "../../lib/content"

if (Astro.params.slug === "sauna-chan") return Astro.redirect("/dopy/sauna-chan", 301)
Astro.response.status = 404
Astro.response.headers.set("Cache-Control", "no-store")
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow")
---

<BaseLayout
  title={`Страница не найдена — ${siteIdentity.name}`}
  description="Запрошенный ресурс не найден."
  contentAvailable={false}
  noindex
>
  <SitePageShell><main class="site-theme min-h-screen bg-[var(--site-color-bg)] p-8 text-[var(--site-color-text)]"><h1 class="site-type-h1">Страница не найдена</h1></main></SitePageShell>
</BaseLayout>
