---
import { ArticleCard, Breadcrumbs, Grid, SectionHeading } from '@crm/site-ui';
import Container from '@crm/site-ui/astro/Container';
import SitePageShell from '@crm/site-ui/astro/SitePageShell';
import BaseLayout from '../layouts/BaseLayout.astro';
import NavigationIsland from '../components/islands/NavigationIsland';
import Footer from '../components/sections/Footer.astro';
import { BLOG_ARTICLES } from '../data/blogData';
import { publicRoute, siteIdentity } from '../lib/content';
import { getPublishedSiteSettings, toFooterNavigation, toSiteNavigation } from '../lib/content/cms-public';

const canonical = new URL(publicRoute('/blog').pathname, Astro.site).toString();
const title = `Идеи и советы для отдыха — ${siteIdentity.name}`;
const description = 'Подборка идей для загородного отдыха, праздников, бани и выбора площадки.';
const publishedSiteSettings = await getPublishedSiteSettings();
const navigation = publishedSiteSettings ? toSiteNavigation(publishedSiteSettings) : undefined;
const footerNavigation = publishedSiteSettings ? toFooterNavigation(publishedSiteSettings) : undefined;
---

<BaseLayout {title} {description} {canonical}>
  <NavigationIsland {...(navigation ? { navigation } : {})} client:load />
  <SitePageShell>
    <Container as="main" class="pt-6 pb-12">
      <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Блог' }]} />
      <section data-section-key="blog" class="site-section site-section--compact">
        <SectionHeading level={1} title="Идеи для отдыха и праздников на природе" description="Практичные подсказки по выбору домика, площадки и сценария выезда." eyebrow="Блог" />
        <Grid desktopColumns={2}>
          {BLOG_ARTICLES.map((article, index) => (
            <ArticleCard href="/blog" title={article.title} description={article.description} category={article.category} analyticsId={`blog.card-${index + 1}`} />
          ))}
        </Grid>
      </section>
    </Container>
    <Footer {...(footerNavigation ? { navigation: footerNavigation } : {})} />
  </SitePageShell>
</BaseLayout>
