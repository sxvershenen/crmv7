---
import BaseLayout from "../layouts/BaseLayout.astro"
import SitePageFrame from "@crm/site-ui/astro/SitePageFrame"
import SitePageShell from "@crm/site-ui/astro/SitePageShell"
import { publicRoute, siteIdentity } from "../lib/content"
import NavigationIsland from "../components/islands/NavigationIsland"
import HeroIsland from "../components/islands/HeroIsland"
import EventsIsland from "../components/islands/EventsIsland"
import HousesIsland from "../components/islands/HousesIsland"
import SaunaChanIsland from "../components/islands/SaunaChanIsland"
import ProgramsIsland from "../components/islands/ProgramsIsland"
import VenuesIsland from "../components/islands/VenuesIsland"
import ReviewsIsland from "../components/islands/ReviewsIsland"
import TerritoryMapIsland from "../components/islands/TerritoryMapIsland"
import FaqLocationIsland from "../components/islands/FaqLocationIsland"
import BookingQuizIsland from "../components/islands/BookingQuizIsland"
import FloatingHelperIsland from "../components/islands/FloatingHelperIsland"
import WhyUsSection from "../components/sections/WhyUsSection.astro"
import BlogSection from "../components/sections/BlogSection.astro"
import PartnersMarquee from "../components/sections/PartnersMarquee.astro"
import EditorialContent from "../components/sections/EditorialContent.astro"
import Footer from "../components/sections/Footer.astro"
import ContentFailure from "../components/ContentFailure.astro"
import { fixtureContentEnabled, getDraftPreview, getPreviewHomepageCommerce, getPublishedRoute, getPublishedSiteSettings, toFooterNavigation, toSiteHero, toSiteNavigation, toSitePromo, toSiteStructuredData } from "../lib/content/cms-public"
import { getHomepageSections } from "../lib/content/homepage-sections"
import { curatedHomepageItems } from "../lib/content/homepage-commerce"

const previewRequested = Astro.url.searchParams.has("__cms_preview")
const previewToken = Astro.url.searchParams.get("__cms_preview") ?? ""
const preview = previewRequested && previewToken.length >= 32 ? await getDraftPreview(previewToken) : null
const previewDocument = preview?.status === "published" && preview.value.renderable && preview.value.path === "/" && preview.value.page.path === "/" ? preview.value : null
const previewCommerce = previewDocument ? await getPreviewHomepageCommerce(previewDocument.page.sections) : null
const result = previewRequested || fixtureContentEnabled ? null : await getPublishedRoute("/")
const publishedPage = previewRequested ? previewDocument?.page ?? null : result?.status === "published" ? result.value.page : null
const publishedSiteSettings = previewRequested ? await getPublishedSiteSettings() : result?.status === "published" ? result.value.settings : null
const fixture = fixtureContentEnabled && !previewRequested
const homepageSections = getHomepageSections(publishedPage, fixture)
const commerce = previewRequested ? previewCommerce?.status === "published" ? previewCommerce.value : undefined : result?.status === "published" ? result.value.commerce : undefined
Astro.response.headers.set("Cache-Control", "no-store")
if (previewRequested) {
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive")
  Astro.response.headers.set("Referrer-Policy", "no-referrer")
}
const failure = previewRequested ? !previewDocument ? "not_found" : previewCommerce?.status !== "published" ? "unavailable" : null : result && result.status !== "published" ? result.status : null
const contentAvailable = !failure
if (failure) {
  Astro.response.status = failure === "not_found" ? 404 : 503
  Astro.response.statusText = failure === "not_found" ? "Not Found" : "Service Unavailable"
  Astro.response.headers.set("Cache-Control", "no-store")
  Astro.response.headers.set("X-Robots-Tag", previewRequested ? "noindex, nofollow, noarchive" : "noindex, nofollow")
  if (failure === "unavailable") Astro.response.headers.set("Retry-After", "60")
}
const canonical = publishedPage?.seo.canonical.mode === "custom"
  ? publishedPage.seo.canonical.url
  : new URL(publicRoute("/").pathname, Astro.site).toString()
const robots = failure || fixtureContentEnabled || previewRequested ? "noindex_nofollow" : publishedPage?.seo.indexPolicy
const navigation = publishedSiteSettings ? toSiteNavigation(publishedSiteSettings) : undefined
const footerNavigation = publishedSiteSettings ? toFooterNavigation(publishedSiteSettings) : undefined
// Inheritance and disabled slots have already been materialized by the release.
const effectiveHero = publishedPage?.hero
const originalHero = effectiveHero ? toSiteHero(effectiveHero) : undefined
const hero = originalHero && previewRequested ? {
  ...originalHero,
  primaryCta: originalHero.primaryCta.action === "booking" ? { ...originalHero.primaryCta, enabled: false } : originalHero.primaryCta,
  secondaryCta: originalHero.secondaryCta.action === "booking" ? { ...originalHero.secondaryCta, enabled: false } : originalHero.secondaryCta,
} : originalHero
const promos = (previewRequested ? previewDocument?.featuredPromotions ?? [] : result?.status === "published" ? result.value.page.featuredPromotions : []).map(toSitePromo)
const failureTitle = failure === "not_found" ? "Страница не найдена" : "Сайт временно недоступен"
---

<BaseLayout
  title={failure ? failureTitle : publishedPage?.seo.title ?? siteIdentity.title}
  description={failure ? "Попробуйте открыть страницу позже." : publishedPage?.seo.description ?? siteIdentity.description}
  contentAvailable={contentAvailable && !previewRequested}
  canonical={canonical}
  robots={robots}
  social={publishedPage?.seo.social}
  structuredData={!previewRequested && publishedPage ? toSiteStructuredData(publishedPage.seo.structuredData) : []}
  {...(!previewRequested && publishedSiteSettings ? { metrika: publishedSiteSettings.value.analytics.metrika } : {})}
  {...(publishedSiteSettings?.value.footerDetails ? { contactDetails: publishedSiteSettings.value.footerDetails } : {})}
  {...(publishedSiteSettings ? { publicSiteName: publishedSiteSettings.value.siteName } : {})}
>
  {contentAvailable && <NavigationIsland {...(navigation ? { navigation } : {})} {...(publishedSiteSettings?.value.footerDetails ? { contactDetails: publishedSiteSettings.value.footerDetails } : {})} client:load />}

  <SitePageShell>
    {failure ? <ContentFailure status={failure} /> : <SitePageFrame>
      {(fixture || hero) && <HeroIsland {fixture} promos={promos} {...(hero ? { hero } : {})} client:load />}
      {publishedPage && !hero && <h1 class="site-type-h1">{publishedPage.title}</h1>}
      {homepageSections.map((section) => {
        if (section.key === "body") return <EditorialContent config={section.config} sectionKey="body" />
        if (section.key === "events") return <EventsIsland config={section.config} published={commerce?.programs} {fixture} client:visible />
        if (section.key === "houses") return <HousesIsland config={section.config} published={curatedHomepageItems(commerce?.houses, section.config.selectedOfferingIds)} {fixture} client:visible />
        if (section.key === "sauna-chan") return <SaunaChanIsland config={section.config} {fixture} client:visible />
        if (section.key === "programs") return <ProgramsIsland config={section.config} published={curatedHomepageItems(commerce?.programs, section.config.selectedOfferingIds)} {fixture} client:visible />
        if (section.key === "venues") return <VenuesIsland config={section.config} published={curatedHomepageItems(commerce?.venues, section.config.selectedOfferingIds)} {fixture} client:visible />
        if (section.key === "blog") return <BlogSection config={section.config} />
        if (section.key === "why-us") return <WhyUsSection config={section.config} />
        if (section.key === "reviews") return <ReviewsIsland config={section.config} {fixture} client:visible />
        if (section.key === "map") return <TerritoryMapIsland config={section.config} client:visible />
        if (section.key === "faq" || section.key === "directions") return <FaqLocationIsland config={section.config} {...(publishedSiteSettings?.value.footerDetails ? { contactDetails: publishedSiteSettings.value.footerDetails } : {})} client:visible />
        if (section.key === "calculator") return previewRequested ? null : <BookingQuizIsland config={section.config} commerce={commerce} {fixture} client:visible />
        if (section.key === "partners") return <PartnersMarquee config={section.config} />
        return null
      })}
    </SitePageFrame>}

    {contentAvailable && (fixture || publishedPage?.sections.some((section) => section.key === "footer")) && <Footer {...(footerNavigation ? { navigation: footerNavigation } : {})} {...(publishedSiteSettings?.value.footerDetails ? { details: publishedSiteSettings.value.footerDetails } : {})} {...(publishedSiteSettings ? { siteName: publishedSiteSettings.value.siteName } : {})} />}
  </SitePageShell>

  {contentAvailable && !previewRequested && <FloatingHelperIsland {...(publishedSiteSettings?.value.footerDetails ? { contactDetails: publishedSiteSettings.value.footerDetails } : {})} client:idle />}
</BaseLayout>
