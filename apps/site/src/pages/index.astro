---
import BaseLayout from "../layouts/BaseLayout.astro"
import { CmsPartnersSectionSchema } from "@crm/contracts"
import { DEFAULT_PARTNERS_CONFIG } from "../data/publicContentDefaults"
import SitePageFrame from "@crm/site-ui/astro/SitePageFrame"
import SitePageShell from "@crm/site-ui/astro/SitePageShell"
import { publicRoute, siteIdentity } from "../lib/content"
import NavigationIsland from "../components/islands/NavigationIsland"
import HeroIsland from "../components/islands/HeroIsland"
import EventsIsland from "../components/islands/EventsIsland"
import HousesIsland from "../components/islands/HousesIsland"
import SaunaChanIsland from "../components/islands/SaunaChanIsland"
import ProgramsIsland from "../components/islands/ProgramsIsland"
import VenuesIsland from "../components/islands/VenuesIsland"
import ReviewsIsland from "../components/islands/ReviewsIsland"
import TerritoryMapIsland from "../components/islands/TerritoryMapIsland"
import FaqLocationIsland from "../components/islands/FaqLocationIsland"
import BookingQuizIsland from "../components/islands/BookingQuizIsland"
import FloatingHelperIsland from "../components/islands/FloatingHelperIsland"
import WhyUsSection from "../components/sections/WhyUsSection.astro"
import BlogSection from "../components/sections/BlogSection.astro"
import PartnersMarquee from "../components/sections/PartnersMarquee.astro"
import Footer from "../components/sections/Footer.astro"
import ContentFailure from "../components/ContentFailure.astro"
import { fixtureContentEnabled, getPublishedRoute, toFooterNavigation, toSiteHero, toSiteNavigation, toSiteStructuredData } from "../lib/content/cms-public"

const result = fixtureContentEnabled ? null : await getPublishedRoute("/")
const publishedPage = result?.status === "published" ? result.value.page : null
const publishedSiteSettings = result?.status === "published" ? result.value.settings : null
const partnersSection = publishedPage?.sections.find((section) => section.key === "partners")
const partnersConfig = fixtureContentEnabled ? DEFAULT_PARTNERS_CONFIG : partnersSection ? CmsPartnersSectionSchema.parse(partnersSection).config : null
const failure = result && result.status !== "published" ? result.status : null
const contentAvailable = !failure
if (failure) {
  Astro.response.status = failure === "not_found" ? 404 : 503
  Astro.response.statusText = failure === "not_found" ? "Not Found" : "Service Unavailable"
  Astro.response.headers.set("Cache-Control", "no-store")
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow")
  if (failure === "unavailable") Astro.response.headers.set("Retry-After", "60")
}
const canonical = publishedPage?.seo.canonical.mode === "custom"
  ? publishedPage.seo.canonical.url
  : new URL(publicRoute("/").pathname, Astro.site).toString()
const robots = failure || fixtureContentEnabled ? "noindex_nofollow" : publishedPage?.seo.indexPolicy
const navigation = publishedSiteSettings ? toSiteNavigation(publishedSiteSettings) : undefined
const footerNavigation = publishedSiteSettings ? toFooterNavigation(publishedSiteSettings) : undefined
// Inheritance and disabled slots have already been materialized by the release.
const effectiveHero = publishedPage?.hero
const hero = effectiveHero ? toSiteHero(effectiveHero) : undefined
const sectionEnabled = (key: string) => fixtureContentEnabled || Boolean(publishedPage?.sections.some((section) => section.key === key))
const failureTitle = failure === "not_found" ? "Страница не найдена" : "Сайт временно недоступен"
---

<BaseLayout
  title={failure ? failureTitle : publishedPage?.seo.title ?? siteIdentity.title}
  description={failure ? "Попробуйте открыть страницу позже." : publishedPage?.seo.description ?? siteIdentity.description}
  {contentAvailable}
  canonical={canonical}
  robots={robots}
  social={publishedPage?.seo.social}
  structuredData={publishedPage ? toSiteStructuredData(publishedPage.seo.structuredData) : []}
>
  {contentAvailable && <NavigationIsland {...(navigation ? { navigation } : {})} client:load />}

  <SitePageShell>
    {failure ? <ContentFailure status={failure} /> : <SitePageFrame>
      {(fixtureContentEnabled || hero) && <HeroIsland {...(hero ? { hero } : {})} client:load />}
      {publishedPage && !hero && <h1 class="site-type-h1">{publishedPage.title}</h1>}
      {sectionEnabled("events") && <EventsIsland client:visible />}
      {sectionEnabled("houses") && <HousesIsland client:visible />}
      {sectionEnabled("sauna-chan") && <SaunaChanIsland client:visible />}
      {sectionEnabled("programs") && <ProgramsIsland client:visible />}
      {sectionEnabled("venues") && <VenuesIsland client:visible />}
      {sectionEnabled("blog") && <BlogSection />}
      {sectionEnabled("why-us") && <WhyUsSection />}
      {sectionEnabled("reviews") && <ReviewsIsland client:visible />}
      {sectionEnabled("map") && <TerritoryMapIsland client:visible />}
      {(sectionEnabled("faq") || sectionEnabled("directions")) && <FaqLocationIsland client:visible />}
      {sectionEnabled("calculator") && <BookingQuizIsland client:visible />}
      {partnersConfig && <PartnersMarquee config={partnersConfig} />}
    </SitePageFrame>}

    {contentAvailable && sectionEnabled("footer") && <Footer {...(footerNavigation ? { navigation: footerNavigation } : {})} />}
  </SitePageShell>

  {contentAvailable && <FloatingHelperIsland client:idle />}
</BaseLayout>
