---
import type { PublicEventServiceSummary } from "@crm/contracts"
import { ArrowRight, CalendarHeart, Users } from "lucide-react"

interface Props {
  eventService: PublicEventServiceSummary
}

const { eventService } = Astro.props
const formatLabel = {
  wedding: "Свадебное мероприятие",
  corporate: "Корпоративное мероприятие",
  birthday: "День рождения",
  other: "Авторское мероприятие",
}[eventService.format]
const durationLabel = eventService.fulfillment.durationMinutes >= 60
  ? `${Math.floor(eventService.fulfillment.durationMinutes / 60)} ч`
  : `${eventService.fulfillment.durationMinutes} мин`
const guestLabel = eventService.fulfillment.minimumGuests === null && eventService.fulfillment.maximumGuests === null
  ? "Количество гостей уточняется"
  : eventService.fulfillment.minimumGuests === null
    ? `до ${eventService.fulfillment.maximumGuests} гостей`
    : eventService.fulfillment.maximumGuests === null
      ? `от ${eventService.fulfillment.minimumGuests} гостей`
      : `от ${eventService.fulfillment.minimumGuests} до ${eventService.fulfillment.maximumGuests} гостей`
const readinessLabel = eventService.readiness === "request_only" ? "По запросу" : "Временно недоступно"
---

<section class="site-section site-section--compact" data-section-key="event-service-detail" data-route-kind="event-service">
  <div class="grid gap-3 lg:grid-cols-12 lg:gap-4">
    <div class="lg:col-span-7 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] font-[var(--site-weight-medium)] text-[var(--site-color-brand-700)]">
        <CalendarHeart className="h-4 w-4" /> {formatLabel}
      </div>
      <p class="mt-5 max-w-prose text-[length:var(--site-text-body)] leading-relaxed text-[var(--site-color-text-muted)]">{eventService.summary ?? "Описание мероприятия готовится редакцией."}</p>
      <dl class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Длительность</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{durationLabel}</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Гости</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{guestLabel}</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Доступность</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{readinessLabel}</dd></div>
      </dl>
    </div>
    <aside class="lg:col-span-5 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]"><Users className="h-4 w-4" /> {guestLabel}</div>
      <div class="mt-4 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">стоимость</div>
      <div class="mt-1 text-[length:var(--site-text-price)] font-[var(--site-weight-semibold)] tracking-[-.6px] text-[var(--site-color-brand-700)]">По запросу</div>
      <div class="mt-1 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Составим программу и рассчитаем стоимость под вашу дату</div>
      <button data-site-action="booking" data-site-item={`Мероприятие: ${eventService.title}`} class="site-button site-button--primary mt-5 w-full">Обсудить мероприятие <ArrowRight className="h-4 w-4" /></button>
    </aside>
  </div>
</section>
