---
import { Award, MapPin, ShieldCheck, Sparkles, Trees } from "lucide-react";
import SiteSectionHeader from "@crm/site-ui/astro/SiteSectionHeader";
import { RESORT_IMAGES, WHY_US_FACTS } from "../../data/resortData";

const getFactIcon = (id: string) => {
  switch (id) {
    case "distance":
      return MapPin;
    case "nature":
      return Trees;
    case "team":
      return Sparkles;
    case "allinclusive":
      return Award;
    default:
      return ShieldCheck;
  }
};

---

<section data-section-key="why-us" class="w-full py-8">
  <SiteSectionHeader
    eyebrow="Почему мы"
    eyebrowTone="brand"
    title="Почему выбирают нас"
    description="Конкретные доказательства вместо общих эпитетов. Всё, что можно посчитать, — посчитали."
  >
    <ShieldCheck slot="icon" className="w-3 h-3" />
  </SiteSectionHeader>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-4">
    <div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-3 lg:gap-4">
      {WHY_US_FACTS.map((fact) => {
        const FactIcon = getFactIcon(fact.id);
        return (
          <div class="group bg-[var(--site-color-surface)] rounded-[var(--site-radius-xl)] p-3 lg:p-5 flex lg:flex-col items-center lg:items-start gap-3 lg:gap-6 lg:min-h-[220px] hover:-translate-y-[3px] transition-transform">
                <div class="icon-tile !w-11 !h-11 lg:!w-12 lg:!h-12 group-hover:bg-[var(--site-color-brand-50)] group-hover:text-[var(--site-color-brand-700)] transition-colors">
                  <FactIcon className="w-5 h-5" strokeWidth={1.8} />
                </div>
            <div class="flex-1 lg:mt-auto min-w-0">
              <h3 class="text-[length:var(--site-text-card-title)] lg:text-[length:var(--site-text-title-sm)] font-[var(--site-weight-semibold)] text-[var(--site-color-text)] leading-tight">
                {fact.number} {fact.title}
              </h3>
            <p class="text-[length:var(--site-text-caption)] lg:text-[length:var(--site-text-body-sm)] text-[var(--site-color-text-muted)] mt-1 lg:mt-2 leading-[1.5]">
              {fact.desc}
            </p>
            </div>
          </div>
        );
      })}
    </div>

    <div class="lg:col-span-5 card group/card flex flex-col hover:-translate-y-[3px] transition-transform">
      <div class="card-img aspect-[4/3] lg:aspect-auto lg:flex-1 lg:min-h-[320px] img-dim">
        <img
          src={RESORT_IMAGES.teamPhoto}
          alt="Команда Зажигай"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 z-10 p-4 flex flex-col justify-end text-[var(--site-color-text-inverse)]">
          <span class="chip on-img w-fit mb-2">Команда «Зажигай»</span>
          <div class="text-[length:var(--site-text-h3)] lg:text-[length:var(--site-text-price)] font-[var(--site-weight-semibold)] tracking-[-.6px] leading-tight">Профессиональная команда рядом на каждом этапе</div>
        </div>
      </div>
      <div class="px-2 pt-3 pb-2">
        <div class="flex items-center justify-between gap-3">
          <div class="text-[length:var(--site-text-body-sm)] text-[var(--site-color-text-muted)] leading-[1.5]">
            Проживание и событие в одном месте: гости не разъезжаются по домам, а идут спать в домики.
          </div>
          <div class="flex -space-x-2 shrink-0" aria-hidden="true">
            {[0, 1, 2].map((item) => <img src={RESORT_IMAGES.teamPhoto} alt="" class="w-9 h-9 rounded-[var(--site-radius-round)] object-cover border-2 border-[var(--site-color-surface)]" style={`object-position: ${30 + item * 25}% center`} />)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
