---
import { Award, MapPin, ShieldCheck, Sparkles, Trees } from "lucide-react";
import { RESORT_IMAGES, WHY_US_FACTS } from "../../data/resortData";

const getFactIcon = (id: string) => {
  switch (id) {
    case "distance":
      return MapPin;
    case "nature":
      return Trees;
    case "team":
      return Sparkles;
    case "allinclusive":
      return Award;
    default:
      return ShieldCheck;
  }
};

const getFactIconClass = (id: string) =>
  id === "team" ? "w-5 h-5 text-[#FAAB2B]" : id === "allinclusive" ? "w-5 h-5 text-[#EE2F2E]" : "w-5 h-5 text-[#2B9E47]";
---

<section class="w-full py-8">
  <div class="mb-6">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white text-[10px] font-semibold tracking-wider uppercase text-[#18191b] mb-2.5">
      <ShieldCheck className="w-3 h-3 text-[#2B9E47]" />
      Факты и цифры
    </div>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-2 md:gap-4">
      <h2 class="text-[26px] sm:text-[32px] font-semibold text-[#18191b] leading-tight tracking-tight">
        Почему выбирают «Свистоплясово»
      </h2>
      <p class="hidden md:block text-[13px] text-[#6b7280] max-w-md font-normal leading-relaxed text-left md:text-right">
        Честные преимущества без преувеличений — всё проверено сотнями счастливых гостей
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      {WHY_US_FACTS.map((fact) => {
        const FactIcon = getFactIcon(fact.id);
        const factIconClass = getFactIconClass(fact.id);

        return (
          <div class="p-5 rounded-3xl bg-white flex flex-col justify-between transition-transform">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 rounded-2xl bg-[#f7f7f7] flex items-center justify-center">
                  <FactIcon className={factIconClass} />
                </div>
                <span class="text-[24px] font-semibold text-[#2B9E47] tracking-tight">
                  {fact.number}
                </span>
              </div>

              <h3 class="text-[16px] font-semibold text-[#18191b] mb-1.5 leading-snug">
                {fact.title}
              </h3>
            </div>

            <p class="text-[12px] text-[#6b7280] leading-relaxed">
              {fact.desc}
            </p>
          </div>
        );
      })}
    </div>

    <div class="lg:col-span-5 rounded-3xl bg-white p-3.5 flex flex-col justify-between">
      <div class="relative h-[220px] sm:h-[260px] rounded-2xl overflow-hidden bg-neutral-100 mb-4">
        <img
          src={RESORT_IMAGES.teamPhoto}
          alt="Команда Зажигай"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>

        <div class="absolute bottom-3 left-3 right-3 text-white">
          <div class="text-[16px] font-semibold leading-tight">
            Event-команда «Зажигай»
          </div>
        </div>
      </div>

      <div class="px-1.5">
        <div class="text-[13px] text-[#2d3134] leading-relaxed mb-3">
          Мы не просто сдаём дома — мы создаем душевные воспоминания. Все сценарии, музыкальное сопровождение и безопасность контролируются нашими штатными сотрудниками.
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-neutral-100 text-[11px] text-[#6b7280]">
          <span>Опыт работы: с 2017 года</span>
          <span class="text-[#2B9E47] font-medium">Более 1 200 событий</span>
        </div>
      </div>
    </div>
  </div>
</section>
