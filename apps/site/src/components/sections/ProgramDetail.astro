---
import type { PublicProgramSummary } from "@crm/contracts"
import { ArrowRight, CalendarDays, Users } from "lucide-react"

interface Props {
  program: PublicProgramSummary
}

const { program } = Astro.props
const price = program.price.mode === "request" ? null : new Intl.NumberFormat("ru-RU", { style: "currency", currency: program.price.amount.currency, maximumFractionDigits: 0 }).format(program.price.amount.amountMinor / 100)
const duration = program.fulfillment.durationMinutes >= 60 ? `${Math.floor(program.fulfillment.durationMinutes / 60)} ч` : `${program.fulfillment.durationMinutes} мин`
const readinessLabel = program.readiness === "ready" ? "Есть ближайшее проведение" : "Уточним ближайшую дату"
const nextOccurrence = program.fulfillment.nextOccurrence ? new Intl.DateTimeFormat("ru-RU", { dateStyle: "long", timeStyle: "short", timeZone: program.timezone }).format(new Date(program.fulfillment.nextOccurrence.startsAt)) : null
const capacityLabel = program.fulfillment.minimumParticipants === null || program.fulfillment.minimumParticipants === 0 ? `до ${program.fulfillment.participantLimit} участников` : `от ${program.fulfillment.minimumParticipants} до ${program.fulfillment.participantLimit} участников`
const priceLabel = program.price.mode === "exact" ? "стоимость" : "стоимость от"
---

<section class="site-section site-section--compact" data-section-key="program-detail" data-route-kind="program">
  <div class="grid gap-3 lg:grid-cols-12 lg:gap-4">
    <div class="lg:col-span-7 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] font-[var(--site-weight-medium)] text-[var(--site-color-brand-700)]">
        <CalendarDays className="h-4 w-4" /> Готовая программа
      </div>
      <p class="mt-5 max-w-prose text-[length:var(--site-text-body)] leading-relaxed text-[var(--site-color-text-muted)]">{program.summary ?? "Описание программы готовится редакцией."}</p>
      <dl class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Участники</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{capacityLabel}</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Длительность</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{duration}</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Доступность</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{readinessLabel}</dd></div>
      </dl>
    </div>
    <aside class="lg:col-span-5 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]"><Users className="h-4 w-4" /> {capacityLabel}</div>
      <div class="mt-4 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">{price ? priceLabel : "стоимость"}</div>
      <div class="mt-1 text-[length:var(--site-text-price)] font-[var(--site-weight-semibold)] tracking-[-.6px] text-[var(--site-color-brand-700)]">{price ?? "По запросу"}</div>
      {program.priceBasisLabel && <div class="mt-1 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">{program.priceBasisLabel}</div>}
      {nextOccurrence && <div class="mt-5 rounded-[var(--site-radius-lg)] border border-[var(--site-color-border)] p-3 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Ближайшее проведение: <span class="font-[var(--site-weight-medium)] text-[var(--site-color-text)]">{nextOccurrence}</span></div>}
      <button data-site-action="booking" data-site-item={`Программа: ${program.title}`} class="site-button site-button--primary mt-5 w-full">Оставить заявку <ArrowRight className="h-4 w-4" /></button>
    </aside>
  </div>
</section>
