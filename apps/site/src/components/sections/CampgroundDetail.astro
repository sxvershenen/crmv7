---
import type { PublicCampgroundSummary } from "@crm/contracts"
import { ArrowRight, Tent, Users } from "lucide-react"

interface Props {
  campground: PublicCampgroundSummary
}

const { campground } = Astro.props
const ownedTent = campground.fulfillment.salesUnit === "owned_tent"
const capacityLabel = ownedTent ? `до ${campground.fulfillment.guestCapacityTotal} гостей` : `до ${campground.fulfillment.capacityTotal} палаточных мест`
const price = campground.price.mode === "request" ? null : new Intl.NumberFormat("ru-RU", { style: "currency", currency: campground.price.amount.currency, maximumFractionDigits: 0 }).format(campground.price.amount.amountMinor / 100)
const readinessLabel = campground.readiness === "ready" ? "Можно забронировать" : campground.readiness === "temporarily_unavailable" ? "Временно недоступен" : "Уточним доступность"
---

<section class="site-section site-section--compact" data-section-key="campground-detail" data-route-kind="campground">
  <div class="grid gap-3 lg:grid-cols-12 lg:gap-4">
    <div class="lg:col-span-7 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] font-[var(--site-weight-medium)] text-[var(--site-color-brand-700)]">
        <Tent className="h-4 w-4" /> {ownedTent ? "Наша палатка" : "Место для своей палатки"}
      </div>
      <p class="mt-5 max-w-prose text-[length:var(--site-text-body)] leading-relaxed text-[var(--site-color-text-muted)]">{campground.summary ?? "Описание кемпинга готовится редакцией."}</p>
      <dl class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Вместимость</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{capacityLabel}</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Тариф</dt><dd class="mt-1 font-[var(--site-weight-medium)]">За ночь</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Доступность</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{readinessLabel}</dd></div>
      </dl>
    </div>
    <aside class="lg:col-span-5 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]"><Users className="h-4 w-4" /> Палаточный формат</div>
      <div class="mt-4 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">стоимость от</div>
      <div class="mt-1 text-[length:var(--site-text-price)] font-[var(--site-weight-semibold)] tracking-[-.6px] text-[var(--site-color-brand-700)]">{price ?? "По запросу"}</div>
      {campground.priceBasisLabel && <div class="mt-1 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">{campground.priceBasisLabel}</div>}
      <button data-site-action="booking" data-site-item={`Кемпинг: ${campground.title}`} class="site-button site-button--primary mt-5 w-full">Оставить заявку <ArrowRight className="h-4 w-4" /></button>
    </aside>
  </div>
</section>
