---
import type { PublicVenueSummary } from "@crm/contracts"
import { ArrowRight, MapPin, Users } from "lucide-react"

interface Props {
  venue: PublicVenueSummary
}

const { venue } = Astro.props
const price = venue.price.mode === "request" ? null : new Intl.NumberFormat("ru-RU", { style: "currency", currency: venue.price.amount.currency, maximumFractionDigits: 0 }).format(venue.price.amount.amountMinor / 100)
const priceLabel = venue.price.mode === "exact" ? "стоимость" : "стоимость от"
const capacityLabel = venue.fulfillment.capacityTotal > 0 ? `до ${venue.fulfillment.capacityTotal} гостей` : "Вместимость уточняется"
const spaceLabel = venue.fulfillment.spaceType === "outdoor" ? "На природе" : venue.fulfillment.spaceType === "indoor" ? "В помещении" : venue.fulfillment.spaceType === "mixed" ? "В помещении и на природе" : "Формат уточняется"
const readinessLabel = venue.readiness === "ready" ? "Можно забронировать" : venue.readiness === "temporarily_unavailable" ? "Временно недоступна" : "Уточним доступность"
---

<section class="site-section site-section--compact" data-section-key="venue-detail" data-route-kind="venue">
  <div class="grid gap-3 lg:grid-cols-12 lg:gap-4">
    <div class="lg:col-span-7 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] font-[var(--site-weight-medium)] text-[var(--site-color-brand-700)]">
        <MapPin className="h-4 w-4" /> Площадка для событий
      </div>
      <p class="mt-5 max-w-prose text-[length:var(--site-text-body)] leading-relaxed text-[var(--site-color-text-muted)]">{venue.summary ?? "Описание площадки готовится редакцией."}</p>
      <dl class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Вместимость</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{capacityLabel}</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Пространство</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{spaceLabel}</dd></div>
        <div class="rounded-[var(--site-radius-lg)] bg-[var(--site-color-bg)] p-3"><dt class="text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">Доступность</dt><dd class="mt-1 font-[var(--site-weight-medium)]">{readinessLabel}</dd></div>
      </dl>
    </div>
    <aside class="lg:col-span-5 rounded-[var(--site-radius-xl)] bg-[var(--site-color-surface)] p-5 sm:p-7">
      <div class="flex items-center gap-2 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]"><Users className="h-4 w-4" /> {capacityLabel}</div>
      <div class="mt-4 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">{price ? priceLabel : "стоимость"}</div>
      <div class="mt-1 text-[length:var(--site-text-price)] font-[var(--site-weight-semibold)] tracking-[-.6px] text-[var(--site-color-brand-700)]">{price ?? "По запросу"}</div>
      {venue.priceBasisLabel && <div class="mt-1 text-[length:var(--site-text-caption)] text-[var(--site-color-text-muted)]">{venue.priceBasisLabel}</div>}
      <button data-site-action="booking" data-site-item={`Площадка: ${venue.title}`} class="site-button site-button--primary mt-5 w-full">Оставить заявку <ArrowRight className="h-4 w-4" /></button>
    </aside>
  </div>
</section>
