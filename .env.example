APP_ENV=development
API_PORT=3000
# Credentialed browser origins only (CRM and CMS). Public site calls public API through its same-origin server/proxy.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Cross-app deep links. Production may replace these with same-origin paths.
VITE_CRM_APP_URL=http://localhost:5173
VITE_ADMIN_APP_URL=http://localhost:5174
DATABASE_URL=postgres://crm:crm@localhost:5433/crm_v7
TEST_DATABASE_URL=postgres://crm:crm@localhost:5433/crm_v7_test
LOG_LEVEL=info
RUN_MIGRATIONS=false
SESSION_COOKIE_NAME=sv_session
SESSION_TTL_HOURS=168
