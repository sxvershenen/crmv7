APP_ENV=development
API_PORT=3000
# Credentialed browser origins only (CRM and CMS). Public site calls public API through its same-origin server/proxy.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Cross-app deep links. Production may replace these with same-origin paths.
VITE_CRM_APP_URL=http://localhost:5173
VITE_ADMIN_APP_URL=http://localhost:5174
DATABASE_URL=postgres://crm:crm@localhost:5433/crm_v7
TEST_DATABASE_URL=postgres://crm:crm@localhost:5433/crm_v7_test
LOG_LEVEL=info
RUN_MIGRATIONS=false
SESSION_COOKIE_NAME=sv_session
SESSION_TTL_HOURS=168
# Media: local storage/scanner is for development only. Production requires S3-compatible storage,
# an external fail-closed scanner and a CDN base URL.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ROOT=.data/media
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE_URL=
MEDIA_UPLOAD_SIGNING_SECRET=
MEDIA_SCANNER_DRIVER=disabled
MEDIA_SCANNER_URL=
MEDIA_SCANNER_TIMEOUT_MS=5000
MEDIA_PROCESSING_MAX_ATTEMPTS=5
MEDIA_PROCESSING_RETRY_BASE_MS=30000
MEDIA_PROCESSING_LEASE_MS=300000
MEDIA_CLEANUP_GRACE_HOURS=24
MEDIA_CLEANUP_INTERVAL_MS=3600000
