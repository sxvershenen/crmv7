{
  "name": "svistoplyasovo-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @crm/app dev",
    "dev:site": "pnpm --filter @crm/site dev",
    "dev:api": "pnpm --filter @crm/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @crm/app test",
    "test:e2e": "pnpm --filter @crm/app test:e2e",
    "test:e2e:api": "pnpm --filter @crm/app test:e2e:api",
    "test:integration": "pnpm --filter @crm/api test:integration",
    "db:migrate": "pnpm --filter @crm/db migration:run",
    "db:seed": "pnpm --filter @crm/api seed",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
